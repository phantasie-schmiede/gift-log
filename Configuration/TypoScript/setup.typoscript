plugin {
  tx_giftlog {
    persistence.storagePid = {$plugin.tx_contactbook.persistence.storagePid}

    view {
      partialRootPaths {
        10 = {$plugin.tx_contactbook.view.partialRootPath}
        20 = {$plugin.tx_templates.view.partialRootPath}
      }
    }
  }

  tx_giftlog_gift.view.defaultPid = auto
  tx_giftlog_history.view.defaultPid = auto
}
